{
  "name": "portfolio-resume",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pdf": "concurrently \"vite\" \"tsx server/index.ts\"",
    "type-check": "vue-tsc --build",
    "build": "vite build",
    "preview": "vite preview",
    "ci": "run-s type-check build",
    "pdf-server": "cross-env NODE_ENV=production tsx server/index.ts",
    "ci:pdf": "npm run build && concurrently \"vite preview --host 127.0.0.1\" \"cross-env NODE_ENV=production tsx server/index.ts\""
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@iconify/vue": "^5.0.1",
    "@quasar/extras": "^2.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "gsap": "^3.15.0",
    "quasar": "^2.21.3",
    "victormono": "^1.5.6",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.12.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.0.2",
    "postcss": "^8.5.19",
    "puppeteer": "^24.43.1",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
